rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sessions collection
    match /sessions/{roomCode} {
      // Allow reading and updating session status (lobby, question, results, leaderboard, ended)
      allow read, create, update: if true;
      
      // Questions subcollection
      match /questions/{questionId} {
        allow read, write: if true;
      }
      
      // Players subcollection
      match /players/{playerId} {
        allow read, create, update, delete: if true;


        
        // Answers subcollection
        match /answers/{questionId} {
          allow read: if true;
          // Player can create an answer once for themselves
          allow create: if request.auth != null && request.auth.uid == playerId;
          allow update, delete: if false;
        }
      }
    }
  }
}

